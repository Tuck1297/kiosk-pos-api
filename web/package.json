{
  "name": "kiosk-pos-register",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cashier register UI for the Kiosk POS API (React + Mantine)",
  "scripts": {
    "gen:api": "openapi-typescript ../openapi.yaml -o src/api/schema.d.ts",
    "dev": "npm run gen:api && vite",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/lexend": "^5.1.0",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@tabler/icons-react": "^3.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  }
}
